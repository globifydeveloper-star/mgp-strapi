# Build-time (must be passed as Docker --build-arg in CI, e.g. CodeBuild)
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
AWS_REGION=
AWS_BUCKET=mgpwebsiteuat
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURE=false
EMAIL_DEFAULT_FROM=
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
OTP_SALT=
PINNACLE_API_URL=
PINNACLE_ACCESS_KEY=
CRM_BASE_URL=
CRM_AUTH_URL=
CRM_USERNAME=
CRM_PASSWORD=
INTERNAL_API_SECRET=
ADMIN_PUBLIC_URL=https://cms.example.com
INVITE_NOTIFY_EMAIL=
# Inbox emailed on every new job application (needs the SMTP_* settings above)
HR_NOTIFICATION_EMAIL=
# Admin role codes allowed to use every export/download button (comma-separated).
# Job-application exports are also open to any role with full read access to job applications (e.g. the seeded "hr" role).
EXPORT_ALLOWED_ADMIN_ROLES=strapi-super-admin
CRON_ENABLED=true
CRM_MAX_ATTEMPTS=60
CRM_RETRY_BATCH=25
