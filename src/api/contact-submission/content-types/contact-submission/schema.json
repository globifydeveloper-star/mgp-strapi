{
  "kind": "collectionType",
  "collectionName": "contact_submissions",
  "info": {
    "singularName": "contact-submission",
    "pluralName": "contact-submissions",
    "displayName": "Contact Submission",
    "description": "Submissions received from Contact Us forms"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true,
      "private": true
    },
    "email": {
      "type": "email",
      "private": true
    },
    "branch": {
      "type": "string"
    },
    "message": {
      "type": "text"
    },
    "submittedAt": {
      "type": "datetime"
    },
    "crmPushStatus": {
      "type": "enumeration",
      "enum": [
        "Sent",
        "Pending",
        "Failed",
        "Processing"
      ],
      "default": "Pending",
      "required": true
    },
    "crmLeadId": {
      "type": "string"
    },
    "crmResponse": {
      "type": "json"
    },
    "crmError": {
      "type": "text"
    },
    "crmRequest": {
      "type": "json",
      "private": true
    },
    "crmAttempts": {
      "type": "integer",
      "default": 0,
      "private": true
    },
    "crmNextAttemptAt": {
      "type": "datetime",
      "private": true
    },
    "crmLastAttemptAt": {
      "type": "datetime",
      "private": true
    },
    "crmSyncedAt": {
      "type": "datetime",
      "private": true
    },
    "allLeadDocumentId": {
      "type": "string",
      "private": true
    }
  }
}
