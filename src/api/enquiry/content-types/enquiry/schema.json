{
  "kind": "collectionType",
  "collectionName": "enquiries",
  "info": {
    "singularName": "enquiry",
    "pluralName": "enquiries",
    "displayName": "Enquiry"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "mobile": {
      "type": "string",
      "required": true,
      "private": true
    },
    "email": {
      "type": "email",
      "private": true
    },
    "source": {
      "type": "enumeration",
      "enum": [
        "BLOG",
        "CONTACT_US",
        "HOME_PAGE",
        "LANDING_PAGE",
        "OTHER"
      ],
      "required": true
    },
    "otpVerified": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "crmStatus": {
      "type": "enumeration",
      "enum": [
        "PENDING",
        "SYNCED",
        "FAILED",
        "PROCESSING"
      ],
      "required": true,
      "default": "PENDING"
    },
    "crmLeadId": {
      "type": "string"
    },
    "crmResponse": {
      "type": "json"
    },
    "crmError": {
      "type": "text"
    },
    "syncAttempts": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    },
    "lastSyncAt": {
      "type": "datetime"
    },
    "blog": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::blog-post.blog-post"
    },
    "branchCode": {
      "type": "string"
    },
    "crmRequest": {
      "type": "json",
      "private": true
    },
    "crmNextAttemptAt": {
      "type": "datetime",
      "private": true
    },
    "crmLastAttemptAt": {
      "type": "datetime",
      "private": true
    },
    "crmSyncedAt": {
      "type": "datetime",
      "private": true
    },
    "allLeadDocumentId": {
      "type": "string",
      "private": true
    }
  }
}
