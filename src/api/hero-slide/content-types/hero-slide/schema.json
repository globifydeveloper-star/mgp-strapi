{
  "kind": "collectionType",
  "collectionName": "hero_slides",
  "info": {
    "singularName": "hero-slide",
    "pluralName": "hero-slides",
    "displayName": "Hero Slide"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "order": {
      "type": "integer",
      "min": 1,
      "description": "Position in the homepage slider (1 = first)"
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "standard",
        "scientific",
        "recycling"
      ],
      "description": "Layout used to render the slide: standard (model photo), scientific (purity testing), recycling (feature cards)"
    },
    "heroText": {
      "type": "text"
    },
    "heroSubtext": {
      "type": "text"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "description": "Recommended: 1254 × 1254 px. Recycling slide: wide desktop background, ~1920 × 1080 px"
    },
    "mobileImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "description": "Phones and tablets (scientific poster / recycling background). Falls back to the built-in image if empty. Recommended: portrait ~1080 × 1600 px"
    },
    "slideLink": {
      "type": "string"
    },
    "button1": {
      "type": "component",
      "component": "blog.cta",
      "repeatable": false
    },
    "button2": {
      "type": "component",
      "component": "blog.cta",
      "repeatable": false
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "shared.slide-feature"
    }
  }
}