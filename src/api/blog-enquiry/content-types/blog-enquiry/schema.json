{
  "kind": "collectionType",
  "collectionName": "blog_enquiries",
  "info": {
    "singularName": "blog-enquiry",
    "pluralName": "blog-enquiries",
    "displayName": "Blog Enquiry",
    "description": "Enquiries received specifically from Blog posts"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "mobile": {
      "type": "string",
      "required": true,
      "private": true
    },
    "email": {
      "type": "email",
      "private": true
    },
    "blogTitle": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "default": "BLOG"
    },
    "submittedAt": {
      "type": "datetime"
    },
    "crmPushStatus": {
      "type": "enumeration",
      "enum": [
        "Sent",
        "Pending",
        "Failed",
        "Processing"
      ],
      "default": "Pending",
      "required": true
    },
    "crmLeadId": {
      "type": "string"
    },
    "crmResponse": {
      "type": "json"
    },
    "crmError": {
      "type": "text"
    },
    "crmRequest": {
      "type": "json",
      "private": true
    },
    "crmAttempts": {
      "type": "integer",
      "default": 0,
      "private": true
    },
    "crmNextAttemptAt": {
      "type": "datetime",
      "private": true
    },
    "crmLastAttemptAt": {
      "type": "datetime",
      "private": true
    },
    "crmSyncedAt": {
      "type": "datetime",
      "private": true
    },
    "allLeadDocumentId": {
      "type": "string",
      "private": true
    }
  }
}
