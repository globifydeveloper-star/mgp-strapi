{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Dynamic client-driven pages with dynamic zone sections"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    },
    "ogImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "page-section.hero-banner",
        "page-section.gold-process",
        "page-section.difference-grid",
        "page-section.promo-slider",
        "page-section.testimonials",
        "page-section.faq",
        "page-section.contact-form"
      ]
    },
    "faqs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::faq.faq",
      "mappedBy": "page"
    }
  }
}
