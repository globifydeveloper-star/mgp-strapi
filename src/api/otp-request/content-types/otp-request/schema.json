{
  "kind": "collectionType",
  "collectionName": "otp_requests",
  "info": {
    "singularName": "otp-request",
    "pluralName": "otp-requests",
    "displayName": "OTP Request"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "phone": {
      "type": "string",
      "required": true,
      "private": true
    },
    "code": {
      "type": "string",
      "required": true,
      "private": true
    },
    "expiresAt": {
      "type": "datetime",
      "required": true,
      "private": true
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "private": true
    },
    "attempts": {
      "type": "integer",
      "default": 0,
      "private": true
    },
    "verifiedAt": {
      "type": "datetime",
      "private": true
    },
    "consumedAt": {
      "type": "datetime",
      "private": true
    },
    "name": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "message": {
      "type": "text"
    },
    "consent": {
      "type": "boolean",
      "default": false
    },
    "ipHash": {
      "type": "string",
      "private": true
    }
  }
}
