    },
    "stepDescription": {
      "type": "text"
    },
    "leftDescription": {
      "type": "text"
    },
    "stepImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "description": "Recommended: 1536 × 1024 px (Process step) or ~800 × 800 px (Value gold)"
    }
  }
}
