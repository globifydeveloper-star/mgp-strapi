{
  "kind": "collectionType",
  "collectionName": "faqs",
  "info": {
    "singularName": "faq",
    "pluralName": "faqs",
    "displayName": "FAQ"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "question": {
      "type": "string"
    },
    "answer": {
      "type": "richtext"
    },
    "section": {
      "type": "enumeration",
      "enum": [
        "home",
        "gold-rate",
        "about-us",
        "faq"
      ]
    },
    "category": {
      "type": "string",
      "description": "Filter group on the FAQ page, e.g. General, Valuation & Purity"
    },
    "order": {
      "type": "integer",
      "min": 0
    },
    "page": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::page.page",
      "inversedBy": "faqs"
    }
  }
}
