{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": {
    "singularName": "testimonial",
    "pluralName": "testimonials",
    "displayName": "Testimonial"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "customerName": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "profilePicture": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "rating": {
      "type": "integer",
      "default": 5
    },
    "testimonialText": {
      "type": "text"
    }
  }
}
