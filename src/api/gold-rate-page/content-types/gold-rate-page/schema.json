{
  "kind": "singleType",
  "collectionName": "gold_rate_pages",
  "info": {
    "singularName": "gold-rate-page",
    "pluralName": "gold-rate-pages",
    "displayName": "Gold Rate Page",
    "description": "Content for the Gold Rate page"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    },
    "ogImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "description": "Recommended: 1200x630 px (Standard OG Image)"
    },
    "hideFooter": {
      "type": "boolean",
      "default": false
    },
    "heroTitle": {
      "type": "string"
    },
    "heroDescription": {
      "type": "text"
    },
    "faqs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::faq.faq"
    },
    "hideNavbar": {
      "type": "boolean",
      "default": false
    }
  }
}