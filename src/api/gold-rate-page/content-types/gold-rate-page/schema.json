{
  "kind": "singleType",
  "collectionName": "gold_rate_pages",
  "info": {
    "singularName": "gold-rate-page",
    "pluralName": "gold-rate-pages",
    "displayName": "Gold Rate Page",
    "description": "Content for the Gold Rate page"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    },
    "ogImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "description": "Recommended: 1200x630 px (Standard OG Image)"
    },
    "hideFooter": {
      "type": "boolean",
      "default": false
    },
    "heroTitle": {
      "type": "string"
    },
    "heroDescription": {
      "type": "text"
    },
    "faqs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::faq.faq"
    },
    "hideNavbar": {
      "type": "boolean",
      "default": false
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "description": "Hero background. Falls back to the built-in image if empty. Recommended: 1920 × 1080 px"
    },
    "whyGoldRateChangesImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "description": "\"Why rates change\" section. Falls back to the built-in image if empty. Recommended: ~800 × 800 px"
    },
    "seoKeywords": {
      "type": "string"
    },
    "heroUpdatedTime": {
      "type": "string"
    },
    "heroLiveLabel": {
      "type": "string"
    },
    "heroCalculateLabel": {
      "type": "string"
    },
    "heroSellLabel": {
      "type": "string"
    },
    "whyTitle": {
      "type": "string"
    },
    "whyTitleHighlight": {
      "type": "string"
    },
    "whyTitleSuffix": {
      "type": "string"
    },
    "whyReasons": {
      "type": "component",
      "repeatable": true,
      "component": "shared.benefit-card"
    },
    "valuationTitle": {
      "type": "string"
    },
    "valuationTitleHighlight": {
      "type": "string"
    },
    "valuationTitleSuffix": {
      "type": "string"
    },
    "valuationSteps": {
      "type": "component",
      "repeatable": true,
      "component": "shared.benefit-card"
    },
    "ctaTitle": {
      "type": "string"
    },
    "ctaSubtext": {
      "type": "string"
    },
    "ctaPrimaryLabel": {
      "type": "string"
    },
    "ctaSecondaryLabel": {
      "type": "string"
    },
    "ctaSecondaryLink": {
      "type": "string"
    },
    "faqHeading": {
      "type": "string"
    },
    "trustItems": {
      "type": "component",
      "repeatable": true,
      "component": "shared.check-item"
    },
    "valuationProcessImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "description": "\"How we value your gold\" section. Falls back to the built-in image if empty. Recommended: 1600 × 1050 px"
    }
  }
}
